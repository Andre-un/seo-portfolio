---
import Base from '../layouts/Base.astro';
---
<Base
  title="Shop — Jędrzej Szymula"
  description="SEO resources, checklists and guides by Jędrzej Szymula."
  path="/shop.html"
  active="shop"
  ogTitle="Shop — SEO Resources by Jędrzej Szymula"
  ogDescription="Practical SEO checklists, frameworks, and guides built from real client work."
>

  <div class="section-label">Resources</div>

  <!-- Product 1 -->
  <article class="product">
    <div class="product-header">
      <span class="product-title">SEO Audit Checklist <span class="badge">Coming soon</span></span>
      <span class="product-price">€19</span>
    </div>
    <p class="product-desc">
      A comprehensive, field-tested checklist for auditing any website's SEO health.
      Covers technical, on-page, content, and off-page signals — structured so you can work through it systematically without missing anything.
    </p>
    <ul class="includes">
      <li>150+ point audit framework</li>
      <li>Priority scoring system (high / medium / low impact)</li>
      <li>Annotated with explanations for each item</li>
      <li>Compatible with any site type or CMS</li>
    </ul>
    <div class="tags">
      <span class="tag">Technical SEO</span>
      <span class="tag">Audit</span>
      <span class="tag">Checklist</span>
    </div>
    <a href="mailto:j.szymula.seo@gmail.com?subject=Waitlist%3A%20SEO%20Audit%20Checklist" class="btn btn-ghost">Join the waitlist by email</a>
  </article>

  <!-- Product 2 -->
  <article class="product">
    <div class="product-header">
      <span class="product-title">Keyword Research Framework <span class="badge">Coming soon</span></span>
      <span class="product-price">€29</span>
    </div>
    <p class="product-desc">
      A repeatable system for finding, qualifying, and prioritising keywords — built around real business goals, not just search volume.
      Includes a pre-built spreadsheet template you can use immediately.
    </p>
    <ul class="includes">
      <li>Step-by-step keyword research process</li>
      <li>Google Sheets template with scoring model</li>
      <li>Intent classification guide</li>
      <li>Worked example from a real project</li>
    </ul>
    <div class="tags">
      <span class="tag">Keyword Research</span>
      <span class="tag">Strategy</span>
      <span class="tag">Template</span>
    </div>
    <a href="mailto:j.szymula.seo@gmail.com?subject=Waitlist%3A%20Keyword%20Research%20Framework" class="btn btn-ghost">Join the waitlist by email</a>
  </article>

  <!-- Product 3 -->
  <article class="product">
    <div class="product-header">
      <span class="product-title">Technical SEO for Non-Developers <span class="badge">Coming soon</span></span>
      <span class="product-price">€39</span>
    </div>
    <p class="product-desc">
      A plain-language guide to the technical side of SEO — written for marketers, founders, and content teams who need to understand and communicate technical issues without coding knowledge.
    </p>
    <ul class="includes">
      <li>Core technical concepts explained clearly</li>
      <li>How to read a crawl report</li>
      <li>What to ask your developer (and why)</li>
      <li>Common mistakes and how to spot them</li>
    </ul>
    <div class="tags">
      <span class="tag">Technical SEO</span>
      <span class="tag">Beginners</span>
      <span class="tag">Guide</span>
    </div>
    <a href="mailto:j.szymula.seo@gmail.com?subject=Waitlist%3A%20Technical%20SEO%20for%20Non-Developers" class="btn btn-ghost">Join the waitlist by email</a>
  </article>

  <!-- Email capture -->
  <div class="notify-box">
    <h2>Get notified when resources launch</h2>
    <p>No spam — one email when something new drops.</p>
    <a href="mailto:j.szymula.seo@gmail.com?subject=Notify%20me%20about%20new%20SEO%20resources" class="btn">Email me to get notified</a>
  </div>
</Base>
